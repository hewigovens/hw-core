# OCI image for running emulator BLE integration tests locally.
# Mirrors the CI workflow in .github/workflows/emu-integration.yml.
#
# Usage:
#   ./scripts/test-emu.sh
#
# Or manually:
#   container build --platform linux/amd64 -f Containerfile.emu-test -t hw-core-emu-test .
#   container run --platform linux/amd64 --rm hw-core-emu-test

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies (matching CI; the core v2.12+ emulator needs SDL3)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl git \
    libdbus-1-dev pkg-config dbus \
    libsdl3-0 libsdl3-image0 libjpeg62-turbo \
    python3-pip python3-venv \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Python virtual environment with trezorlib, bridge deps and the TROPIC01 model (ts-tvl)
ARG TS_TVL_REF=0e50063160a608d6375cd87f3afbc6f1b7726b1b
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir trezor dbus-fast click typing-extensions \
        "git+https://github.com/tropicsquare/ts-tvl@${TS_TVL_REF}"
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /workspace

# Copy the full project
COPY . .

# Patch the emulator binary if present
RUN if [ -f tests/fixtures/trezor-emu-core-T3W1 ]; then \
      patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 \
        --set-rpath /usr/lib/x86_64-linux-gnu \
        tests/fixtures/trezor-emu-core-T3W1 && \
      chmod +x tests/fixtures/trezor-emu-core-T3W1; \
    fi

# Compile the test executables into the image without debug/incremental artifacts.
ARG BUILD_JOBS=4
ENV CARGO_BUILD_JOBS=${BUILD_JOBS}
ENV CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 CARGO_INCREMENTAL=0
RUN cargo build --workspace --locked \
    && cargo test -p hw-cli -p hw-ffi --test emu_ble --no-run --locked

# Run the emulator integration tests
ENV TREZOR_EMU_BINARY=/workspace/tests/fixtures/trezor-emu-core-T3W1
ENV BRIDGE_DIR=/workspace/tests/fixtures
ENV TROPIC_MODEL_CONFIG=/workspace/tests/fixtures/tropic_model/config.yml
CMD ["sh", "-c", "cargo test -p hw-cli --test emu_ble --locked -- --ignored --nocapture --test-threads=1 && cargo test -p hw-ffi --test emu_ble --locked -- --ignored --nocapture --test-threads=1"]

+    private void writeNoResponseWithRetry(
+            SimpleFuture<Void> future,
+            BluetoothGattCharacteristic characteristic,
+            int attempt
+    ) {
+        if (!this.connected || this.gatt == null) {
+            throw new RuntimeException("Disconnected while in write operation");
